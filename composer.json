{
  "name": "kibatic/cms-bundle",
  "description": "Simple block based CMS bundle for Symfony",
  "autoload": {
    "psr-4": {
      "Kibatic\\CmsBundle\\": ""
    }
  },
    "require": {
        "php": "^8.2",
        "symfony/framework-bundle": "^6.4 || ^7.0 || ^8.0",
        "symfony/form": "^6.4 || ^7.0 || ^8.0",
        "symfony/twig-bundle": "^6.4 || ^7.0 || ^8.0",
        "symfony/security-bundle": "^6.4 || ^7.0 || ^8.0",
        "symfony/orm-pack": "^2.0 || ^3.0",
        "stof/doctrine-extensions-bundle": "^1.2 || ^2.0"
    },
    "require-dev": {
        "symfony/phpunit-bridge": "^7.0 || ^8.0"
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        }
    }
}
