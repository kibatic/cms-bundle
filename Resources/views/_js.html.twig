<script src="https://cdn.jsdelivr.net/gh/mdbassit/Wysi@latest/dist/wysi.min.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function() {
        Wysi({
            el: '.kcms .wysiwyg',
            darkMode: false,
            height: 300,
            autoGrow: true,
            autoHide: false,
            tools: [
                'format', '|',
                'bold', 'italic', 'underline', 'strike', '|',
                {label: '{{ 'editor.alignment'|trans({}, 'KibaticCmsBundle')|e('js') }}', items: ['alignLeft', 'alignCenter', 'alignRight', 'alignJustify']}, '|',
                'ul', 'ol', '|',
                'indent', 'outdent', '|',
                'link', 'image', 'hr', 'quote', '|',
                'removeFormat'
            ],
            onChange: (content) => {}
        });

        // Block list: filter by slug
        const filter = document.querySelector('[data-kcms-filter]');
        if (filter) {
            const rows = document.querySelectorAll('[data-kcms-slug]');
            const noMatch = document.querySelector('[data-kcms-no-match]');
            filter.addEventListener('input', () => {
                const query = filter.value.trim().toLowerCase();
                let visible = 0;
                rows.forEach(row => {
                    const match = row.dataset.kcmsSlug.toLowerCase().includes(query);
                    row.hidden = !match;
                    visible += match;
                });
                noMatch.hidden = visible > 0;
            });
        }

        // "New block" menu: closes on a click outside or with Escape
        document.querySelectorAll('.kcms-menu').forEach(menu => {
            document.addEventListener('click', event => menu.contains(event.target) || menu.removeAttribute('open'));
            document.addEventListener('keydown', event => event.key === 'Escape' && menu.removeAttribute('open'));
        });

        // "Copy Twig" buttons
        document.querySelectorAll('[data-kcms-copy]').forEach(button => {
            button.addEventListener('click', () => {
                navigator.clipboard.writeText(button.dataset.kcmsCopy).then(() => {
                    const label = button.querySelector('[data-kcms-copy-label]');
                    const text = label.textContent;
                    label.textContent = button.dataset.kcmsCopyDone;
                    button.classList.add('is-done');
                    setTimeout(() => {
                        label.textContent = text;
                        button.classList.remove('is-done');
                    }, 1500);
                });
            });
        });

        // Image blocks: image from the computer, uploaded, its URL put in the URL field (block/_image_upload.html.twig)
        document.querySelectorAll('[data-kcms-upload]').forEach(upload => {
            const urlInput = upload.closest('form').querySelector('[data-kcms-image-url]');
            const urlRow = urlInput.parentElement;
            const fileInput = upload.querySelector('[data-kcms-upload-input]');
            const dropzone = upload.querySelector('[data-kcms-dropzone]');
            const fileBox = upload.querySelector('[data-kcms-upload-file]');
            const name = upload.querySelector('[data-kcms-upload-name]');
            const error = upload.querySelector('[data-kcms-upload-error]');
            const kilobytes = new Intl.NumberFormat(document.documentElement.lang || undefined, {style: 'unit', unit: 'kilobyte', maximumFractionDigits: 0});

            const show = (fileName, size) => {
                // Uploaded image, or image saved inside the block before (data: URL)
                const isFile = urlInput.value.startsWith(upload.dataset.kcmsUploadsPath) || urlInput.value.startsWith('data:');
                upload.classList.toggle('has-file', isFile);
                fileBox.hidden = !isFile;
                urlRow.hidden = isFile;
                if (isFile) {
                    name.textContent = (fileName ?? name.dataset.kcmsUploaded) + (size ? ' · ' + kilobytes.format(size / 1024) : '');
                }
            };
            const setValue = (value, fileName, size) => {
                urlInput.value = value;
                urlInput.dispatchEvent(new Event('input', {bubbles: true}));
                show(fileName, size);
            };
            const fail = (message) => {
                error.textContent = message;
                error.hidden = false;
            };
            const read = async (file) => {
                error.hidden = true;
                if (!file.type.startsWith('image/')) {
                    return fail(upload.dataset.kcmsNotImage);
                }
                if (file.size > upload.dataset.kcmsMaxSize) {
                    return fail(upload.dataset.kcmsTooBig);
                }
                fail(upload.dataset.kcmsUploading);
                error.classList.add('is-pending');
                try {
                    const body = new FormData();
                    body.append('file', file);
                    const response = await fetch(upload.dataset.kcmsUploadUrl, {method: 'POST', headers: {'X-CSRF-Token': upload.dataset.kcmsCsrf}, body});
                    const data = await response.json();
                    if (!response.ok) {
                        return fail(data.error ?? upload.dataset.kcmsFailed);
                    }
                    error.hidden = true;
                    setValue(data.url, data.name, data.size);
                } catch (exception) {
                    fail(upload.dataset.kcmsFailed);
                } finally {
                    error.classList.remove('is-pending');
                }
            };

            fileInput.addEventListener('change', () => {
                fileInput.files.length && read(fileInput.files[0]);
                fileInput.value = '';
            });
            upload.querySelector('[data-kcms-upload-remove]').addEventListener('click', () => setValue(''));
            dropzone.addEventListener('dragover', event => {
                event.preventDefault();
                dropzone.classList.add('is-over');
            });
            dropzone.addEventListener('dragleave', () => dropzone.classList.remove('is-over'));
            dropzone.addEventListener('drop', event => {
                event.preventDefault();
                dropzone.classList.remove('is-over');
                event.dataTransfer.files.length && read(event.dataTransfer.files[0]);
            });
            // Ctrl+V of a copied image, anywhere on the page
            document.addEventListener('paste', event => {
                const file = [...event.clipboardData.files].find(f => f.type.startsWith('image/'));
                if (file) {
                    event.preventDefault();
                    read(file);
                }
            });
            show();
        });

        // Metablocks: layout and blocks, written in JSON in the hidden content field (block/_meta_editor.html.twig)
        document.querySelectorAll('[data-kcms-meta-editor]').forEach(editor => {
            const field = editor.closest('form').querySelector('[data-kcms-meta-content]');
            const choices = JSON.parse(editor.dataset.kcmsChoices);
            const list = editor.querySelector('[data-kcms-meta-items]');
            const columns = editor.querySelector('[data-kcms-meta-columns]');
            const choice = editor.querySelector('[data-kcms-meta-choice]');
            let meta = {layout: 'stack', columns: 2, items: []};
            try {
                meta = {...meta, ...JSON.parse(field.value || '{}')};
            } catch (exception) {}
            const escape = text => text.replace(/[&<>"']/g, c => ({'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'})[c]);
            const save = () => {
                field.value = JSON.stringify(meta);
                field.dispatchEvent(new Event('input', {bubbles: true}));
            };
            const draw = () => {
                editor.querySelectorAll('[data-kcms-meta-layout]').forEach(radio => radio.checked = radio.value === meta.layout);
                editor.querySelector('[data-kcms-meta-columns-row]').hidden = meta.layout !== 'columns';
                columns.value = meta.columns;
                editor.dataset.layout = meta.layout;
                editor.querySelector('[data-kcms-meta-empty]').hidden = meta.items.length > 0;
                list.innerHTML = meta.items.map((item, index) => `
                    <li class="kcms-meta-item${item.slug in choices ? '' : ' is-missing'}" data-index="${index}">
                        <span class="kcms-meta-position">${index + 1}</span>
                        <span class="kcms-slug">${escape(item.slug)}</span>
                        ${item.slug in choices ? `<span class="kcms-badge">${escape(choices[item.slug])}</span>` : `<span class="kcms-meta-missing">${escape(editor.dataset.kcmsMissing)}</span>`}
                        <input type="text" class="kcms-meta-title" data-action="title" value="${escape(item.title ?? '')}" placeholder="${escape(editor.dataset.kcmsTitlePlaceholder)}" maxlength="80">
                        <span class="kcms-meta-actions">
                            <button type="button" data-action="up" title="${escape(editor.dataset.kcmsUp)}" aria-label="${escape(editor.dataset.kcmsUp)}" ${index === 0 ? 'disabled' : ''}>↑</button>
                            <button type="button" data-action="down" title="${escape(editor.dataset.kcmsDown)}" aria-label="${escape(editor.dataset.kcmsDown)}" ${index === meta.items.length - 1 ? 'disabled' : ''}>↓</button>
                            <button type="button" data-action="remove" title="${escape(editor.dataset.kcmsRemove)}" aria-label="${escape(editor.dataset.kcmsRemove)}">×</button>
                        </span>
                    </li>`).join('');
            };
            editor.querySelectorAll('[data-kcms-meta-layout]').forEach(radio => radio.addEventListener('change', () => {
                meta.layout = radio.value;
                save();
                draw();
            }));
            columns.addEventListener('change', () => {
                meta.columns = Number(columns.value);
                save();
            });
            editor.querySelector('[data-kcms-meta-add]').addEventListener('click', () => {
                if (choice.value) {
                    meta.items.push({slug: choice.value, title: null});
                    choice.value = '';
                    save();
                    draw();
                }
            });
            list.addEventListener('click', event => {
                const button = event.target.closest('button[data-action]');
                if (!button) {
                    return;
                }
                const index = Number(button.closest('li').dataset.index);
                const move = {up: -1, down: 1}[button.dataset.action];
                if (move) {
                    [meta.items[index], meta.items[index + move]] = [meta.items[index + move], meta.items[index]];
                } else {
                    meta.items.splice(index, 1);
                }
                save();
                draw();
            });
            list.addEventListener('input', event => {
                if (event.target.dataset.action === 'title') {
                    meta.items[Number(event.target.closest('li').dataset.index)].title = event.target.value || null;
                    save();
                }
            });
            // Normalized right away, without marking the form as modified
            field.value = JSON.stringify(meta);
            draw();
        });

        // Image blocks: live preview of the URL
        document.querySelectorAll('[data-kcms-image-preview]').forEach(preview => {
            const input = preview.closest('form').querySelector('[data-kcms-image-url]');
            const image = preview.querySelector('img');
            const caption = preview.querySelector('figcaption');
            const emptyText = caption.textContent;
            image.addEventListener('load', () => preview.classList.add('is-loaded'));
            image.addEventListener('error', () => {
                preview.classList.remove('is-loaded');
                preview.classList.add('is-broken');
                image.removeAttribute('src');
                caption.textContent = preview.dataset.kcmsBroken;
            });
            const update = () => {
                preview.classList.remove('is-loaded', 'is-broken');
                caption.textContent = emptyText;
                input.value.trim() ? image.src = input.value.trim() : image.removeAttribute('src');
            };
            input.addEventListener('input', update);
            update();
        });

        // Editor: Ctrl+S saves, leaving with unsaved changes asks first
        const forms = document.querySelectorAll('[data-kcms-form]');
        let dirty = false;
        forms.forEach(form => {
            form.addEventListener('input', () => dirty = true);
            form.addEventListener('submit', () => dirty = false);
        });
        if (forms.length > 0) {
            window.addEventListener('beforeunload', event => {
                if (dirty) {
                    event.preventDefault();
                }
            });
            document.addEventListener('keydown', event => {
                if ((event.ctrlKey || event.metaKey) && event.key === 's') {
                    event.preventDefault();
                    const form = document.activeElement?.closest('[data-kcms-form]') ?? forms[0];
                    form.requestSubmit();
                }
            });
        }
    });
</script>
