{% extends '@KibaticCms/layout.html.twig' %}
{% trans_default_domain 'KibaticCmsBundle' %}
{% import '@KibaticCms/_macros.html.twig' as kcms %}

{% block kcms_body %}
    {% set csrf = csrf_token(constant('Kibatic\\CmsBundle\\Controller\\SnapshotController::CSRF_TOKEN_ID')) %}
    {% set previewed = cms_snapshot_preview() %}

    <nav class="kcms-crumbs"><a href="{{ path('cms_block_index') }}">{{ 'index.title'|trans }}</a><span>{{ 'snapshot.title'|trans }}</span></nav>

    <header class="kcms-head">
        <div>
            <h1 class="kcms-title">{{ 'snapshot.title'|trans }}</h1>
            <p class="kcms-subtitle">{{ 'snapshot.subtitle'|trans }}</p>
        </div>
    </header>

    <form method="post" action="{{ path('cms_snapshot_create') }}" class="kcms-card kcms-snapshot-take">
        <input type="hidden" name="_token" value="{{ csrf }}">
        <button type="submit" class="kcms-btn kcms-btn-primary kcms-btn-xl">
            {{ kcms.camera_icon() }}
            {{ 'snapshot.take'|trans }}
        </button>
        <label class="kcms-snapshot-name">
            <span>{{ 'snapshot.name'|trans }}</span>
            <input type="text" name="name" maxlength="255" placeholder="{{ 'snapshot.name_placeholder'|trans }}">
        </label>
    </form>

    {% if snapshots is not empty %}
        <div class="kcms-card kcms-card-flush">
            <div class="kcms-table-wrap">
                <table class="kcms-table">
                    <thead>
                        <tr>
                            <th>{{ 'snapshot.column.name'|trans }}</th>
                            <th>{{ 'snapshot.column.date'|trans }}</th>
                            <th>{{ 'snapshot.column.blocks'|trans }}</th>
                            <th>{{ 'snapshot.column.size'|trans }}</th>
                            <th><span class="kcms-sr">{{ 'index.column.actions'|trans }}</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for snapshot in snapshots %}
                            <tr>
                                <td>
                                    <a href="{{ path('cms_snapshot_show', {id: snapshot.id}) }}" class="kcms-snapshot-title">{{ snapshot.name ?? 'snapshot.unnamed'|trans }}</a>
                                    {% if previewed and previewed.id == snapshot.id %}<span class="kcms-badge kcms-badge-accent">{{ 'snapshot.previewing'|trans }}</span>{% endif %}
                                </td>
                                <td class="kcms-muted">{{ snapshot.createdAt|date('format.datetime'|trans) }}</td>
                                <td>{{ 'index.blocks'|trans({count: snapshot.blockCount}) }}</td>
                                <td class="kcms-muted">{{ 'snapshot.size'|trans({size: (snapshot.size / 1024)|round(1)}) }}</td>
                                <td class="kcms-row-actions">
                                    {% include '@KibaticCms/snapshot/_actions.html.twig' %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% else %}
        <div class="kcms-card kcms-empty">
            <h2>{{ 'snapshot.empty.title'|trans }}</h2>
            <p>{{ 'snapshot.empty.text'|trans }}</p>
        </div>
    {% endif %}
{% endblock %}
