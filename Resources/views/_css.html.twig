<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/mdbassit/Wysi@latest/dist/wysi.min.css"/>
<style>
    /* Admin of KibaticCmsBundle: everything is scoped to .kcms so the host application's styles are left alone.
       Override the --kcms-* variables in the application to match its colours. */
    .kcms {
        --kcms-accent: #4f46e5;
        --kcms-accent-hover: #4338ca;
        --kcms-accent-soft: #eef2ff;
        --kcms-text: #0f172a;
        --kcms-muted: #64748b;
        --kcms-border: #e2e8f0;
        --kcms-surface: #ffffff;
        --kcms-subtle: #f8fafc;
        --kcms-danger: #dc2626;
        --kcms-danger-soft: #fef2f2;
        --kcms-success: #15803d;
        --kcms-success-soft: #f0fdf4;
        --kcms-radius: 10px;
        --kcms-shadow: 0 1px 2px rgb(15 23 42 / 6%), 0 1px 3px rgb(15 23 42 / 4%);
        --kcms-mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;

        color: var(--kcms-text);
        font-size: 15px;
        line-height: 1.5;
        margin: 0 auto 48px;
        max-width: 1200px;
    }
    .kcms *, .kcms *::before, .kcms *::after { box-sizing: border-box; }
    .kcms a { color: var(--kcms-accent); text-decoration: none; }
    .kcms a:hover { color: var(--kcms-accent-hover); }
    .kcms code { font-family: var(--kcms-mono); font-size: .88em; background: var(--kcms-subtle); border: 1px solid var(--kcms-border); border-radius: 4px; padding: 1px 5px; }
    .kcms .kcms-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .kcms .kcms-muted { color: var(--kcms-muted); }
    .kcms .kcms-icon { width: 16px; height: 16px; flex: none; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

    /* Page header */
    .kcms .kcms-crumbs { display: flex; gap: 8px; font-size: 13px; color: var(--kcms-muted); margin-bottom: 8px; }
    .kcms .kcms-crumbs span::before { content: "/"; margin-right: 8px; opacity: .5; }
    .kcms .kcms-head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 16px; margin-bottom: 24px; }
    .kcms .kcms-title { font-size: 26px; font-weight: 650; letter-spacing: -.01em; line-height: 1.25; margin: 0; }
    .kcms .kcms-subtitle { display: flex; align-items: center; gap: 8px; color: var(--kcms-muted); margin: 4px 0 0; }
    .kcms .kcms-head-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
    .kcms .kcms-section-title { font-size: 17px; font-weight: 600; margin: 32px 0 12px; text-transform: uppercase; letter-spacing: .04em; }
    .kcms .kcms-slug { font-family: var(--kcms-mono); font-weight: 600; }
    .kcms .kcms-title .kcms-slug { font-size: .9em; }

    /* Buttons */
    .kcms .kcms-btn {
        display: inline-flex; align-items: center; justify-content: center; gap: 6px;
        min-height: 38px; padding: 0 16px; border: 1px solid var(--kcms-border); border-radius: 8px;
        background: var(--kcms-surface); color: var(--kcms-text); font: inherit; font-weight: 550;
        cursor: pointer; white-space: nowrap; user-select: none; transition: background .15s, border-color .15s;
    }
    .kcms .kcms-btn:hover { background: var(--kcms-subtle); border-color: #cbd5e1; color: var(--kcms-text); }
    .kcms .kcms-btn:focus-visible, .kcms .kcms-copy:focus-visible, .kcms .kcms-toggle:focus-visible { outline: 2px solid var(--kcms-accent); outline-offset: 2px; }
    .kcms .kcms-btn-primary { background: var(--kcms-accent); border-color: var(--kcms-accent); color: #fff; }
    .kcms .kcms-btn-primary:hover { background: var(--kcms-accent-hover); border-color: var(--kcms-accent-hover); color: #fff; }
    .kcms .kcms-btn-danger { border-color: transparent; background: none; color: var(--kcms-danger); }
    .kcms .kcms-btn-danger:hover { background: var(--kcms-danger-soft); border-color: transparent; color: var(--kcms-danger); }
    .kcms .kcms-btn-sm { min-height: 30px; padding: 0 12px; font-size: 13px; }
    .kcms .kcms-copy {
        display: inline-flex; align-items: center; gap: 6px; padding: 4px 8px; border: 0; border-radius: 6px;
        background: none; color: var(--kcms-muted); font: inherit; font-size: 13px; cursor: pointer;
    }
    .kcms .kcms-copy:hover { background: var(--kcms-subtle); color: var(--kcms-text); }
    .kcms .kcms-copy.is-done { color: var(--kcms-success); }

    /* Debug switch */
    .kcms .kcms-toggle { display: inline-flex; align-items: center; gap: 8px; color: var(--kcms-muted); font-size: 14px; border-radius: 999px; }
    .kcms .kcms-toggle:hover { color: var(--kcms-text); }
    .kcms .kcms-toggle-track { position: relative; width: 34px; height: 20px; border-radius: 999px; background: #cbd5e1; transition: background .15s; }
    .kcms .kcms-toggle-track::after { content: ""; position: absolute; top: 2px; left: 2px; width: 16px; height: 16px; border-radius: 50%; background: #fff; box-shadow: var(--kcms-shadow); transition: transform .15s; }
    .kcms .kcms-toggle.is-on { color: var(--kcms-text); }
    .kcms .kcms-toggle.is-on .kcms-toggle-track { background: var(--kcms-accent); }
    .kcms .kcms-toggle.is-on .kcms-toggle-track::after { transform: translateX(14px); }

    /* "New block" menu */
    .kcms .kcms-menu { position: relative; }
    .kcms .kcms-menu summary { list-style: none; }
    .kcms .kcms-menu summary::-webkit-details-marker { display: none; }
    .kcms .kcms-menu-list {
        position: absolute; right: 0; top: calc(100% + 6px); z-index: 10; width: 280px; padding: 6px;
        background: var(--kcms-surface); border: 1px solid var(--kcms-border); border-radius: var(--kcms-radius);
        box-shadow: 0 10px 30px rgb(15 23 42 / 12%);
    }
    .kcms .kcms-menu-item { display: flex; gap: 12px; align-items: flex-start; padding: 10px; border-radius: 8px; color: var(--kcms-text); }
    .kcms .kcms-menu-item:hover { background: var(--kcms-accent-soft); color: var(--kcms-text); }
    .kcms .kcms-menu-item .kcms-icon { margin-top: 3px; color: var(--kcms-accent); }
    .kcms .kcms-menu-item span, .kcms .kcms-type-card { display: flex; flex-direction: column; }
    .kcms .kcms-menu-item small, .kcms .kcms-type-card small { color: var(--kcms-muted); font-size: 13px; }

    /* Cards */
    .kcms .kcms-card { background: var(--kcms-surface); border: 1px solid var(--kcms-border); border-radius: var(--kcms-radius); box-shadow: var(--kcms-shadow); padding: 20px; }
    .kcms .kcms-card-flush { padding: 0; overflow: hidden; }
    .kcms .kcms-card-title { font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: .05em; color: var(--kcms-muted); margin: 0 0 16px; }

    /* Block list */
    .kcms .kcms-toolbar { display: flex; gap: 12px; padding: 12px; border-bottom: 1px solid var(--kcms-border); }
    .kcms .kcms-search { position: relative; flex: 1; max-width: 360px; }
    .kcms .kcms-search .kcms-icon { position: absolute; left: 11px; top: 50%; transform: translateY(-50%); color: var(--kcms-muted); }
    .kcms .kcms-table-wrap { overflow-x: auto; }
    .kcms .kcms-table { width: 100%; border-collapse: collapse; margin: 0; }
    .kcms .kcms-table th { padding: 10px 16px; text-align: left; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: .05em; color: var(--kcms-muted); background: var(--kcms-subtle); border-bottom: 1px solid var(--kcms-border); }
    .kcms .kcms-table td { padding: 12px 16px; border-bottom: 1px solid var(--kcms-border); vertical-align: middle; }
    .kcms .kcms-table tbody tr:last-child td { border-bottom: 0; }
    .kcms .kcms-table tbody tr:hover { background: var(--kcms-subtle); }
    .kcms .kcms-row-actions { text-align: right; white-space: nowrap; }
    .kcms .kcms-row-actions .kcms-copy { opacity: 0; transition: opacity .15s; }
    .kcms tr:hover .kcms-copy, .kcms .kcms-copy:focus-visible, .kcms .kcms-copy.is-done { opacity: 1; }
    .kcms .kcms-no-match { margin: 0; padding: 24px; text-align: center; color: var(--kcms-muted); }
    .kcms .kcms-badge { display: inline-flex; align-items: center; gap: 6px; padding: 2px 10px 2px 8px; border-radius: 999px; background: var(--kcms-subtle); border: 1px solid var(--kcms-border); color: var(--kcms-text); font-size: 13px; font-weight: 500; }
    .kcms .kcms-badge .kcms-icon { width: 14px; height: 14px; color: var(--kcms-accent); }
    .kcms .kcms-chips { display: flex; flex-wrap: wrap; gap: 6px; }
    .kcms .kcms-chip { display: inline-block; min-width: 34px; padding: 2px 8px; border-radius: 6px; background: var(--kcms-accent-soft); color: var(--kcms-accent); font-family: var(--kcms-mono); font-size: 12px; font-weight: 600; text-align: center; text-transform: uppercase; }
    .kcms .kcms-chip:hover { background: var(--kcms-accent); color: #fff; }
    .kcms .kcms-chip-missing { background: none; border: 1px dashed #cbd5e1; color: var(--kcms-muted); }
    .kcms .kcms-chip-missing:hover { border-color: var(--kcms-accent); background: none; color: var(--kcms-accent); }

    /* Empty state */
    .kcms .kcms-empty { padding: 40px; text-align: center; }
    .kcms .kcms-empty h2 { font-size: 20px; margin: 0 0 8px; }
    .kcms .kcms-empty p { max-width: 560px; margin: 0 auto 24px; color: var(--kcms-muted); }
    .kcms .kcms-type-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 12px; text-align: left; }
    .kcms .kcms-type-card { gap: 4px; padding: 16px; border: 1px solid var(--kcms-border); border-radius: var(--kcms-radius); color: var(--kcms-text); transition: border-color .15s, background .15s; }
    .kcms .kcms-type-card:hover { border-color: var(--kcms-accent); background: var(--kcms-accent-soft); color: var(--kcms-text); }
    .kcms .kcms-type-card .kcms-icon { width: 22px; height: 22px; color: var(--kcms-accent); margin-bottom: 6px; }

    /* Translation tabs */
    .kcms .kcms-tabs { display: flex; flex-wrap: wrap; gap: 4px; margin-bottom: 16px; border-bottom: 1px solid var(--kcms-border); }
    .kcms .kcms-tab { padding: 8px 14px; margin-bottom: -1px; border-bottom: 2px solid transparent; color: var(--kcms-muted); font-weight: 550; text-transform: uppercase; font-size: 13px; letter-spacing: .04em; }
    .kcms .kcms-tab:hover { color: var(--kcms-text); }
    .kcms .kcms-tab.is-active { color: var(--kcms-accent); border-bottom-color: var(--kcms-accent); }
    .kcms .kcms-tab-add { color: var(--kcms-muted); opacity: .8; }
    .kcms .kcms-tab-end { margin-left: auto; text-transform: none; letter-spacing: 0; }

    /* Editor */
    .kcms .kcms-grid { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 20px; align-items: start; }
    .kcms .kcms-side { display: flex; flex-direction: column; gap: 16px; position: sticky; top: 16px; }
    .kcms .kcms-actions { display: grid; gap: 8px; }
    .kcms .kcms-meta { margin: 0; padding: 0 4px; display: grid; gap: 8px; font-size: 14px; }
    .kcms .kcms-meta div { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
    .kcms .kcms-meta dt { color: var(--kcms-muted); }
    .kcms .kcms-meta dd { margin: 0; }
    .kcms .kcms-image-preview { margin: 16px 0 0; padding: 16px; border: 1px dashed var(--kcms-border); border-radius: var(--kcms-radius); background: var(--kcms-subtle); text-align: center; }
    .kcms .kcms-image-preview img { display: block; max-width: 100%; max-height: 360px; margin: 0 auto; border-radius: 6px; }
    .kcms .kcms-image-preview img:not([src]), .kcms .kcms-image-preview.is-loaded figcaption { display: none; }
    .kcms .kcms-image-preview figcaption { color: var(--kcms-muted); font-size: 14px; }
    .kcms .kcms-image-preview.is-broken figcaption { color: var(--kcms-danger); }

    /* Image from the computer (block/_image_upload.html.twig) */
    .kcms .kcms-upload { margin-bottom: 16px; }
    .kcms .kcms-form .kcms-dropzone {
        display: flex; flex-direction: column; align-items: center; gap: 6px; margin: 0; padding: 28px 16px;
        border: 2px dashed #cbd5e1; border-radius: var(--kcms-radius); background: var(--kcms-subtle);
        text-align: center; font-weight: 400; cursor: pointer; transition: border-color .15s, background .15s;
    }
    .kcms .kcms-dropzone:hover, .kcms .kcms-dropzone.is-over { border-color: var(--kcms-accent); background: var(--kcms-accent-soft); }
    .kcms .kcms-dropzone .kcms-icon { width: 24px; height: 24px; color: var(--kcms-accent); }
    .kcms .kcms-dropzone strong { color: var(--kcms-accent); }
    .kcms .kcms-dropzone small { color: var(--kcms-muted); font-size: 13px; }
    .kcms .kcms-upload-file { display: flex; align-items: center; gap: 10px; padding: 10px 12px; border: 1px solid var(--kcms-border); border-radius: var(--kcms-radius); }
    .kcms .kcms-upload-file .kcms-icon { color: var(--kcms-accent); }
    .kcms .kcms-upload-file span { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 550; }
    .kcms .kcms-form .kcms-upload-file label { display: inline-flex; margin: 0; font-size: 13px; }
    .kcms .kcms-upload-error { margin: 8px 0 0; color: var(--kcms-danger); font-size: 14px; font-weight: 500; }
    .kcms .kcms-upload.has-file .kcms-dropzone, .kcms [hidden] { display: none; }

    /* Form fields (plain form_div_layout markup, see block/_editor.html.twig) */
    .kcms .kcms-form > .kcms-grid div:has(> label) { margin-bottom: 16px; }
    .kcms .kcms-form div:has(> label):last-child { margin-bottom: 0; }
    .kcms .kcms-form label { display: block; margin-bottom: 6px; font-size: 14px; font-weight: 600; }
    .kcms .kcms-form label.required::after { content: " *"; color: var(--kcms-danger); }
    .kcms input:is([type=text], [type=search], [type=url], [type=email], [type=number], :not([type])), .kcms select, .kcms textarea {
        display: block; width: 100%; min-height: 38px; padding: 8px 12px; margin: 0;
        border: 1px solid #cbd5e1; border-radius: 8px; background: var(--kcms-surface);
        color: var(--kcms-text); font: inherit; transition: border-color .15s, box-shadow .15s;
    }
    .kcms textarea { min-height: 220px; resize: vertical; }
    .kcms .kcms-search input[type=search] { padding-left: 34px; }
    .kcms .wysi-wrapper + textarea { display: none; }
    .kcms input:focus, .kcms select:focus, .kcms textarea:focus { outline: 0; border-color: var(--kcms-accent); box-shadow: 0 0 0 3px rgb(79 70 229 / 18%); }
    .kcms #kibatic_cmsbundle_imageblock_content, .kcms [id$=_slug] { font-family: var(--kcms-mono); font-size: 14px; }
    .kcms .kcms-form .help-text { margin-top: 6px; color: var(--kcms-muted); font-size: 13px; }
    .kcms .kcms-form ul { margin: 6px 0 0; padding: 0; list-style: none; color: var(--kcms-danger); font-size: 13px; font-weight: 500; }
    .kcms .kcms-form div:has(> ul) input, .kcms .kcms-form div:has(> ul) textarea { border-color: var(--kcms-danger); }
    .kcms .wysi-wrapper { border-radius: 8px; }

    /* Flash message */
    .kcms .kcms-flash {
        display: flex; align-items: center; gap: 8px; margin-bottom: 16px; padding: 10px 14px;
        border: 1px solid #bbf7d0; border-radius: var(--kcms-radius); background: var(--kcms-success-soft);
        color: var(--kcms-success); font-weight: 550; animation: kcms-flash 4s forwards;
    }
    .kcms .kcms-flash::before { content: "✓"; }
    @keyframes kcms-flash { 0%, 80% { opacity: 1; } 100% { opacity: .55; } }

    @media (max-width: 900px) {
        .kcms .kcms-grid { grid-template-columns: minmax(0, 1fr); }
        .kcms .kcms-side { position: static; }
        .kcms .kcms-row-actions .kcms-copy { display: none; }
    }
</style>
