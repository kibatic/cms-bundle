{% extends '@KibaticCms/layout.html.twig' %}
{% trans_default_domain 'KibaticCmsBundle' %}
{% import '@KibaticCms/_macros.html.twig' as kcms %}

{% block kcms_body %}
    {% set debug = app.request.hasPreviousSession ? app.session.get('cms-debug', false) : false %}

    <header class="kcms-head">
        <div>
            <h1 class="kcms-title">{{ 'index.title'|trans }}</h1>
            <p class="kcms-subtitle">
                {{ 'index.blocks'|trans({count: blocksBySlug|length}) }}
                {%- if i18nDisplay %} · {{ 'index.languages'|trans({count: languages|length}) }}{% endif %}
                {%- set published = cms_published_version() %}
                {%- if published %} · <a href="{{ path('cms_version_index') }}" class="kcms-published-link">{{ 'index.published'|trans({name: published.name ?? published.createdAt|date('format.datetime'|trans)}) }}</a>{% endif %}
                {%- if cms_draft_changes() > 0 %} · <a href="{{ path('cms_version_index') }}" class="kcms-draft-link">{{ 'version.draft.changes'|trans({count: cms_draft_changes()}) }}</a>{% endif %}
            </p>
        </div>

        <div class="kcms-head-actions">
            <a href="{{ path('cms_block_debug') }}" class="kcms-toggle{{ debug ? ' is-on' }}" role="switch" aria-checked="{{ debug ? 'true' : 'false' }}"
               title="{{ 'index.debug_help'|trans }}">
                <span class="kcms-toggle-track"></span> {{ 'index.debug'|trans }}
            </a>

            <a href="{{ path('cms_version_index') }}" class="kcms-btn">
                {{ kcms.versions_icon() }}
                {{ 'version.title'|trans }}
            </a>

            {% if aiEnabled %}
                <a href="{{ path('cms_chat') }}" class="kcms-btn">
                    <svg class="kcms-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M9.9 15.5A2 2 0 0 0 8.5 14.1l-6.1-1.6a.5.5 0 0 1 0-1l6.1-1.6a2 2 0 0 0 1.4-1.4l1.6-6.1a.5.5 0 0 1 1 0l1.6 6.1a2 2 0 0 0 1.4 1.4l6.1 1.6a.5.5 0 0 1 0 1l-6.1 1.6a2 2 0 0 0-1.4 1.4l-1.6 6.1a.5.5 0 0 1-1 0Z"/></svg>
                    {{ 'chat.title'|trans }}
                </a>
            {% endif %}

            <details class="kcms-menu">
                <summary class="kcms-btn kcms-btn-primary">
                    <svg class="kcms-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
                    {{ 'index.new'|trans }}
                </summary>
                <div class="kcms-menu-list">
                    {% for blockTypeName in blockTypeNames %}
                        <a href="{{ path('cms_block_new', {'typeName': blockTypeName}) }}" class="kcms-menu-item">
                            {{ kcms.type_icon(blockTypeName) }}
                            <span>
                                <strong>{{ kcms.type_label(blockTypeName) }}</strong>
                                <small>{{ kcms.type_description(blockTypeName) }}</small>
                            </span>
                        </a>
                    {% endfor %}
                </div>
            </details>
        </div>
    </header>

    {% if blocks|length > 0 %}
        <div class="kcms-card kcms-card-flush">
            <div class="kcms-toolbar">
                <label class="kcms-search">
                    <svg class="kcms-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                    <input type="search" placeholder="{{ 'index.filter'|trans }}" data-kcms-filter aria-label="{{ 'index.filter'|trans }}">
                </label>
                {# Types of the blocks of the list only, in the order of the types #}
                {% set listTypes = blocks|filter(b => b.slug not in hiddenSlugs)|map(b => b.type) %}
                <select class="kcms-type-filter" data-kcms-type-filter aria-label="{{ 'index.type_filter'|trans }}">
                    <option value="">{{ 'index.all_types'|trans }}</option>
                    {% for type in blockTypeNames|filter(type => type in listTypes) %}
                        <option value="{{ type }}">{{ kcms.type_label(type) }}</option>
                    {% endfor %}
                </select>
            </div>

            <div class="kcms-table-wrap">
                <table class="kcms-table">
                    <thead>
                        <tr>
                            <th>{{ 'index.column.slug'|trans }}</th>
                            <th>{{ 'index.column.type'|trans }}</th>
                            {% if i18nDisplay %}<th>{{ 'index.column.languages'|trans }}</th>{% endif %}
                            <th>{{ 'index.column.updated'|trans }}</th>
                            <th><span class="kcms-sr">{{ 'index.column.actions'|trans }}</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        {# The blocks made only for a metablock are listed under it #}
                        {% for slug, slugBlocks in blocksBySlug|filter((b, slug) => slug not in hiddenSlugs) %}
                            {% include '@KibaticCms/block/_block_row.html.twig' with {'slug': slug, 'blocks': slugBlocks, 'level': 0, 'parent': null, 'items': metaItems[slug] ?? []} %}
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            <p class="kcms-no-match" data-kcms-no-match hidden>{{ 'index.no_match'|trans }}</p>
        </div>
    {% else %}
        <div class="kcms-card kcms-empty">
            <h2>{{ 'index.empty.title'|trans }}</h2>
            <p>
                {{ 'index.empty.text'|trans }}
                <code>{{ "{{ cms_block('my-slug') }}" }}</code><br>
                {{ 'index.empty.choose'|trans }}
            </p>
            <div class="kcms-type-grid">
                {% for blockTypeName in blockTypeNames %}
                    <a href="{{ path('cms_block_new', {'typeName': blockTypeName}) }}" class="kcms-type-card">
                        {{ kcms.type_icon(blockTypeName) }}
                        <strong>{{ kcms.type_label(blockTypeName) }}</strong>
                        <small>{{ kcms.type_description(blockTypeName) }}</small>
                    </a>
                {% endfor %}
            </div>
        </div>
    {% endif %}
{% endblock %}
