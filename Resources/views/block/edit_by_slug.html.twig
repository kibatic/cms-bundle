{% extends '@KibaticCms/layout.html.twig' %}
{% trans_default_domain 'KibaticCmsBundle' %}
{% import '@KibaticCms/_macros.html.twig' as kcms %}

{% block kcms_body %}
    <nav class="kcms-crumbs"><a href="{{ path('cms_block_index') }}">{{ 'index.title'|trans }}</a><span>{{ blocks[0].slug }}</span></nav>

    <header class="kcms-head">
        <div>
            <h1 class="kcms-title"><span class="kcms-slug">{{ blocks[0].slug }}</span></h1>
            <p class="kcms-subtitle">{{ 'edit.by_slug'|trans }}</p>
        </div>
        <div class="kcms-head-actions">{{ kcms.copy_snippet(blocks[0].slug) }}</div>
    </header>

    {% for block in blocks %}
        <h2 class="kcms-section-title">
            <a href="{{ path('cms_block_edit', {'id': block.id}) }}">{{ block.language ?? 'language.all_long'|trans }}</a>
        </h2>
        {% include '@KibaticCms/block/_editor.html.twig' with {
            'form': edit_forms[loop.index0],
            'delete_form': delete_forms[loop.index0],
            'submit_label': 'editor.save',
        } %}
    {% endfor %}
{% endblock %}
