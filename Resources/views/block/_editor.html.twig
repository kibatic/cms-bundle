{#
    Block form: content on the left, settings and actions on the right.
    Variables: form, block, delete_form (null when creating), submit_label, back_url and back_label (default: the block list).
    Without slug field (block of a version: VersionController::editBlock()), no settings card.
#}
{% trans_default_domain 'KibaticCmsBundle' %}
{# The admin styles plain form markup, whatever form theme the application uses #}
{% form_theme form with ['form_div_layout.html.twig'] only %}

{{ form_start(form, {'attr': {'id': form.vars.id, 'class': 'kcms-form', 'data-kcms-form': true}}) }}
    <div class="kcms-grid">
        <section class="kcms-card kcms-main">
            {# Errors of the form itself, e.g. those of the hidden content field of a metablock #}
            {% if form.vars.errors|length > 0 %}
                <div class="kcms-form-errors">{{ form_errors(form) }}</div>
            {% endif %}
            {% if block.type == 'image' %}
                {% include '@KibaticCms/block/_image_upload.html.twig' %}
            {% elseif block.type in ['meta', 'navigation'] %}
                {# Visual editor, or its JSON edited by hand (see the code editors in _js.html.twig) #}
                <div class="kcms-mode-tabs" data-kcms-json-mode role="tablist">
                    <button type="button" data-mode="visual" class="is-active">{{ 'editor.mode.visual'|trans }}</button>
                    <button type="button" data-mode="json">{{ 'editor.mode.json'|trans }}</button>
                </div>
                <div data-kcms-visual>
                    {% include '@KibaticCms/block/_' ~ (block.type == 'meta' ? 'meta' : 'navigation') ~ '_editor.html.twig' %}
                </div>
                <div data-kcms-json hidden>
                    <textarea aria-label="JSON"></textarea>
                    <p class="kcms-json-error" data-kcms-json-error data-kcms-invalid="{{ 'editor.mode.invalid'|trans }}" hidden></p>
                    <p class="kcms-muted kcms-meta-help">{{ 'editor.mode.json_help'|trans }}</p>
                </div>
            {% endif %}

            {% if block.type == 'html' %}
                {# Visual editor (simplifies the HTML), or the HTML kept as it is with a preview (see _js.html.twig) #}
                <div class="kcms-mode-tabs" data-kcms-html-mode role="tablist">
                    <button type="button" data-mode="visual" class="is-active">{{ 'editor.mode.visual'|trans }}</button>
                    <button type="button" data-mode="code">{{ 'editor.mode.html'|trans }}</button>
                </div>
                <p class="kcms-warning" data-kcms-html-warning data-kcms-template="{{ 'editor.mode.html_warning'|trans }}"
                   data-kcms-confirm="{{ 'editor.mode.html_confirm'|trans }}" hidden></p>
                <div data-kcms-html-visual>{{ form_row(form.content) }}</div>
                <div class="kcms-html-code" data-kcms-html-code hidden>
                    <textarea aria-label="HTML"></textarea>
                </div>
            {% else %}
                {{ form_row(form.content) }}
            {% endif %}

            {% if form.styles is defined and block.type != 'image' %}
                <details class="kcms-styles"{{ form.styles.vars.value ? ' open' }}>
                    <summary>{{ 'form.styles.summary'|trans }}</summary>
                    {{ form_row(form.styles) }}
                </details>
            {% elseif form.styles is defined %}
                {% do form.styles.setRendered() %}
            {% endif %}

            {% if block.type == 'image' %}
                <figure class="kcms-image-preview" data-kcms-image-preview data-kcms-broken="{{ 'editor.preview.broken'|trans }}">
                    <img alt="{{ 'editor.preview.alt'|trans }}">
                    <figcaption>{{ 'editor.preview.empty'|trans }}</figcaption>
                </figure>
            {% endif %}
        </section>

        <aside class="kcms-side">
            {% if form.slug is defined %}
                <div class="kcms-card">
                    <h2 class="kcms-card-title">{{ 'editor.settings'|trans }}</h2>
                    {{ form_row(form.slug) }}
                    {% if form.language is defined %}{{ form_row(form.language) }}{% endif %}
                    {{ form_rest(form) }}
                </div>
            {% else %}
                {{ form_rest(form) }}
            {% endif %}

            {% if delete_form %}
                <dl class="kcms-meta">
                    <div><dt>{{ 'editor.created'|trans }}</dt><dd>{{ block.createdAt|date('format.datetime'|trans) }}</dd></div>
                    <div><dt>{{ 'editor.updated'|trans }}</dt><dd>{{ block.updatedAt|date('format.datetime'|trans) }}</dd></div>
                </dl>
            {% endif %}

            <div class="kcms-actions">
                <button type="submit" class="kcms-btn kcms-btn-primary" title="Ctrl+S">{{ submit_label|trans }}</button>
                <a href="{{ back_url ?? path('cms_block_index') }}" class="kcms-btn">{{ (back_label ?? 'editor.back')|trans }}</a>
            </div>

            {% if delete_form %}
                <button type="submit" class="kcms-btn kcms-btn-danger" form="{{ delete_form.vars.id }}">{{ 'editor.delete'|trans }}</button>
            {% endif %}
        </aside>
    </div>

    {% if block.type == 'html' %}
        {# Preview of the HTML tab, on the whole width of the page, as the block on the site #}
        <section class="kcms-card kcms-html-preview-card" data-kcms-html-preview-card hidden>
            <h2 class="kcms-card-title">{{ 'editor.mode.preview'|trans }}</h2>
            <div class="kcms-html-preview" data-kcms-html-preview></div>
        </section>
    {% endif %}
{{ form_end(form, {'render_rest': false}) }}

{% if delete_form %}
    {{ form_start(delete_form, {'attr': {
        'id': delete_form.vars.id,
        'hidden': true,
        'onsubmit': 'return confirm(\'' ~ ('editor.delete_confirm'|trans|e('js')) ~ '\')'
    }}) }}
    {{ form_end(delete_form) }}
{% endif %}
